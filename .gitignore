# PC (Desktop) build output — generated by CMakeLists.txt / script_build_and_run.bat
/build_desktop/

# Web build output — generated by build_web.bat / build_web.sh
/web/

# GLM fetched by build_web.sh/.bat (CMake's FetchContent handles this for
# Desktop/Android under build_desktop/ and android/app/.cxx/, already ignored)
/external/

# Android Studio / Gradle (covers android/ and any nested module)
*.iml
.gradle/
.idea/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties

.DS_Store
